export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

use devenv 2>/dev/null

# direnv configuration for this walter development machine.
#
# This file is safe to commit: it contains NO secret values.
# Every credential lives in .envrc.private, which is gitignored.
# Run `direnv allow` once to activate.

# The local OCI DEFAULT profile is session-token based (it has
# security_token_file but no `user` key), so the oci CLI rejects it under the
# default ApiKey auth. This makes plain `oci ...` calls work.
#
# Walter needs this more than ONCE does. `stop` and `start` drive the oci CLI
# directly — power state is not desired state and never reaches OpenTofu — so
# the everyday verbs depend on this variable and on a live session token.
# OpenTofu's oracle/oci provider detects security_token_file by itself and does
# not need it, which is why `create` can succeed where `stop` fails.
#
# Session tokens last 60 minutes. When walter reports an expired one:
#   bb ~/.claude/skills/refresh-oci-token/refresh-oci-token.clj
export OCI_CLI_AUTH=security_token

# COLORS_PAR_* credentials. Nothing here fails when the file is missing, so
# `build` and `create --dry-run` still work on a fresh checkout.
#
# Never export COLORS_PAR_PROFILE. Walter refuses to run when it is set: the
# profile separates this machine's OpenTofu state from other deployments in the
# shared bucket, and overriding it from the environment can only break that.
source_env_if_exists .envrc.private
